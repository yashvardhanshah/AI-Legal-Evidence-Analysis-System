# Copy to .env. Generate a fresh password; never commit the resulting file.
POSTGRES_USER=legal_app
POSTGRES_DB=legal_evidence
POSTGRES_PASSWORD=
# Native backend only: replace REPLACE_ME with the same password (URL encoded).
DATABASE_URL=postgresql+psycopg://legal_app:REPLACE_ME@127.0.0.1:5433/legal_evidence
CORS_ORIGINS=["http://localhost:3000"]
# Next.js server only. Docker overrides this with http://backend:8000.
API_BASE_URL=http://127.0.0.1:8000
